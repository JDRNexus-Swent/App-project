rules_version = '2';

// Storage holds one file per user: their profile picture at profilePictures/{uid}.jpg
// (DATA_ARCHITECTURE.md, section 1.8). The app shrinks it to 256 px before the upload, so the
// 1 MB limit only stops abuse. Any other path is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePictures/{fileName} {
      // Only the owner, like profiles. Anyone with the download URL can still load the picture.
      allow read: if request.auth != null && fileName == request.auth.uid + '.jpg';
      // Upload or overwrite only (no delete): a JPEG under 1 MB, at the owner's own path.
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource != null
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024;
    }
  }
}
